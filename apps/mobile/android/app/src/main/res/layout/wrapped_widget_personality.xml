<?xml version="1.0" encoding="utf-8"?>
<!-- Sample text doubles as the widget picker preview (previewLayout); replaced at runtime. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/wrapped_bg_dark">

    <ImageView
        android:id="@+id/bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/eyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.1"
            android:maxLines="1"
            android:text="SEU PERFIL 2026"
            android:textColor="@color/wrapped_orange"
            android:textSize="10sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="bottom"
            android:orientation="vertical">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_compass" />

            <TextView
                android:id="@+id/personality_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="Explorador"
                android:textColor="@color/wrapped_white"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/personality_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="2"
                android:text="de mundos abertos"
                android:textColor="@color/wrapped_gray"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/personality_chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/wrapped_pill_orange_soft"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:paddingStart="8dp"
                android:paddingTop="3dp"
                android:paddingEnd="8dp"
                android:paddingBottom="3dp"
                android:text="78% RPG"
                android:textColor="@color/wrapped_orange"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
