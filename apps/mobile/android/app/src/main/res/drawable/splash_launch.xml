<?xml version="1.0" encoding="utf-8"?>
<!--
    Launch background before Android 12 (where the system splash is not available): the logo centred on
    #1A1A1A, drawn at the same size as the web EntrySplash so the animated one picks up from it.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/splash_background" />
    <item
        android:width="288dp"
        android:height="288dp"
        android:drawable="@drawable/ic_splash_logo"
        android:gravity="center" />
</layer-list>
