<?xml version="1.0" encoding="utf-8"?>
<!--
    Launch background before Android 12 (where the system splash is not available): the logo centred on the
    default theme's splash background, drawn at the same size as the native EntrySplashView so the animated
    one picks up from it. Default theme only: it is a static window background chosen at build time, so other
    themes start with the default colors here (EntrySplashView then paints the theme's own).
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/splash_background" />
    <item
        android:width="288dp"
        android:height="288dp"
        android:drawable="@drawable/ic_splash_logo"
        android:gravity="center" />
</layer-list>
