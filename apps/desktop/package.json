{
  "name": "desktop",
  "version": "0.1.0",
  "private": true,
  "description": "GameNode desktop owned library",
  "author": "GameNode",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:windows": "bash scripts/dev-windows.sh",
    "package:windows": "bash scripts/package-windows.sh",
