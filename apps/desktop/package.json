{
  "name": "desktop",
  "version": "0.1.0",
  "private": true,
  "description": "GameNode desktop launcher",
  "author": "GameNode",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:windows": "bash scripts/dev-windows.sh",
    "package:windows": "bash scripts/package-windows.sh",
    "build": "electron-vite build",
    "lint": "eslint src --ext .ts,.tsx",
    "type-check": "tsc --noEmit",
    "test": "vitest run --threads=false",
    "package": "electron-builder --publish never"
  },
  "dependencies": {
    "@mantine/core": "^9.0.1",
    "@mantine/hooks": "^9.0.1",
    "@repo/locales": "*",
    "@repo/ui": "0.0.0",
    "@repo/wrapper": "0.0.0",
    "@tabler/icons-react": "^3.41.1",
    "@tanstack/react-query": "^5.90.5",
    "@tanstack/react-virtual": "3.14.25",
    "better-auth": "1.7.14",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@repo/eslint-config": "0.0.0",
    "@repo/tailwind-config": "0.0.0",
    "@repo/typescript-config": "0.0.0",
    "@tailwindcss/container-queries": "^0.1.1",
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.0.4",
    "autoprefixer": "^10.4.21",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "postcss": "8.5.6",
    "postcss-import": "^15.1.0",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "tailwindcss": "3.4.3",
    "typescript": "5.9.2",
    "vite": "^7.1.9",
    "vitest": "0.34.6"
  }
}
