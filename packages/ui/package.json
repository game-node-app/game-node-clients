{
  "name": "@repo/ui",
  "version": "0.0.0",
  "sideEffects": [
    "**/*.css"
  ],
  "type": "module",
  "imports": {
    "#@/*": [
      "./src/*",
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*/index.ts",
      "./src/*/index.tsx"
    ]
  },
  "exports": {
    ".": "./src/index.ts",
    "./themes.css": "./src/theme/generated/themes.css",
    "./theme/dev/contrast-monitor": "./src/theme/dev/ContrastMonitor.tsx",
    "./theme/anchors/console": "./src/theme/packs/anchors/console.tsx",
    "./theme/anchors/ruins-screens": "./src/theme/packs/anchors/ruinsScreens.tsx",
    "./theme/anchors/xbox-screens": "./src/theme/packs/anchors/xboxScreens.tsx"
  },
  "private": true,
  "license": "MIT",
  "scripts": {
    "lint": "eslint src --ext .ts,.tsx && node ../../packages/config-eslint/bin/lint-css-colors.js src && node ../../packages/config-eslint/bin/colors.js check",
    "type-check": "tsc --noEmit",
    "themes:generate": "tsx scripts/generate-themes.ts",
    "themes:check": "tsx scripts/generate-themes.ts --check",
    "barrels:generate": "barrelsby -c barrelsby.json"
  },
  "dependencies": {
    "@better-auth/oauth-provider": "1.7.14",
    "@repo/locales": "workspace:*",
    "@repo/wrapper": "workspace:*",
    "mediabunny": "1.66.0"
  },
  "peerDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.2.2",
    "@mantine/carousel": "^9.0.1",
    "@mantine/charts": "^9.0.1",
    "@mantine/core": "^9.0.1",
    "@mantine/dates": "^9.0.1",
    "@mantine/dropzone": "^9.0.1",
    "@mantine/hooks": "^9.0.1",
    "@mantine/next": "^6.0.22",
    "@mantine/notifications": "^9.0.1",
    "@mantine/nprogress": "^9.0.1",
    "@mantine/tiptap": "^9.0.1",
    "@tabler/icons-react": "^3.41.1",
    "@tanstack/react-query": "^5.90.5",
    "@tiptap/core": "^3.22.2",
    "@tiptap/extension-image": "^3.22.2",
    "@tiptap/extension-link": "^3.22.2",
    "@tiptap/extension-mention": "^3.22.2",
    "@tiptap/extension-placeholder": "^3.22.2",
    "@tiptap/extension-text-style": "^3.22.2",
    "@tiptap/extension-youtube": "^3.22.2",
    "@tiptap/pm": "^3.22.2",
    "@tiptap/react": "^3.22.2",
    "@tiptap/starter-kit": "^3.22.2",
    "@tiptap/suggestion": "^3.22.2",
    "better-auth": "1.7.14",
    "dayjs": "^1.11.18",
    "embla-carousel-autoplay": "^8.6.0",
    "html-to-image": "1.11.13",
    "react-easy-crop": "^5.5.3",
    "react-hook-form": "^8.0.0-alpha.5",
    "tailwind-merge": "^3.3.1",
    "ts-pattern": "5.8.0",
    "use-long-press": "3.3.0",
    "yet-another-react-lightbox": "^3.25.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.53.0",
    "@repo/eslint-config": "workspace:*",
    "@repo/tailwind-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/culori": "4.0.1",
    "@types/react": "19.3.0",
    "autoprefixer": "^10.4.21",
    "axe-core": "4.11.0",
    "barrelsby": "^2.8.1",
    "culori": "4.0.2",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.3",
    "tsup": "^8.5.0",
    "tsx": "4.23.15",
    "typescript": "5.9.2"
  }
}
