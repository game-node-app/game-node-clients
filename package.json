{
  "private": true,
  "scripts": {
    "changeset": "changeset",
    "release:plan": "node scripts/release-plan.cjs",
    "test:releases": "node --test scripts/*.test.cjs",
    "build": "turbo build",
    "dev": "turbo dev",
    "dev:web": "pnpm dev -F web",
    "dev:mobile": "pnpm dev -F mobile",
    "dev:admin": "pnpm dev -F admin",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "clean": "turbo clean",
    "mismatches:list": "syncpack lint",
    "mismatches:fix": "syncpack fix",
    "mismatches:format": "syncpack format",
    "wrapper:generate": "pnpm build -F @repo/wrapper",
    "locales:generate-types": "pnpm --filter @repo/locales translations:types",
    "locales:watch-types": "pnpm --filter @repo/locales translations:types:watch",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "@changesets/cli": "2.29.8",
    "prettier": "3.5.3",
    "prettier-plugin-tailwindcss": "^0.5.14",
    "syncpack": "^14.3.0",
    "turbo": "2.11.11",
    "yaml": "^2.8.1",
    "@changesets/parse": "0.4.3"
  },
  "engines": {
    "node": ">=22"
  },
  "name": "game-node-clients",
  "packageManager": "pnpm@10.34.9",
  "dependencies": {}
}
